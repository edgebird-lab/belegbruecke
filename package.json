{
  "name": "belegbruecke",
  "private": true,
  "version": "0.0.1",
  "description": "E-Rechnungen annehmen, nach EN 16931 und XRechnung prüfen, GoBD-gerecht archivieren und monatlich an die Steuerkanzlei (DATEV) übergeben.",
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "dev": "vite",
    "server": "node src/server/start.ts",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "abdeckung": "vitest run --coverage",
    "lint": "oxlint",
    "preview": "vite preview",
    "e2e": "playwright test",
    "vorbereiten": "node scripts/artefakte.mjs && node scripts/sef.mjs",
    "artefakte": "node scripts/artefakte.mjs",
    "sef": "node scripts/sef.mjs",
    "referenz": "node scripts/referenz.mjs",
    "programm:server": "node scripts/programm-server.mjs",
    "programm:server-test": "node scripts/programm-server-test.mjs",
    "tauri": "tauri",
    "desktop:build": "tauri build",
    "desktop:test": "node scripts/desktop-test.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "fast-xml-parser": "^5.12.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.17",
    "imapflow": "^2.11.0",
    "mailparser": "^3.14.3",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "saxon-js": "^2.7.0",
    "xmllint-wasm": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "oxlint": "^1.93.0",
    "rolldown": "~1.2.18",
    "typescript": "~7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "xslt3": "^2.7.0"
  }
}
